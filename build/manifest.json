{
  "manifest_version": 3,
  "name": "Expo Gain Curve",
  "version": "0.1.0",
  "description": "Inject interactive exponential curve visualizations into any webpage",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Expo Gain Curve"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
