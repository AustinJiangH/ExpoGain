{
  "name": "expogain-chrome-extension",
  "version": "0.1.0",
  "description": "Chrome extension built with React, TypeScript, Webpack, and TailwindCSS",
  "scripts": {
    "dev": "webpack --mode=development --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --mode=production",
    "clean": "rm -rf build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.8",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
